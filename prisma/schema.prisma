generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  EMPLOYEE
  GA
  BRANCH_HEAD
  TREASURER

  // Pertahankan selama migrasi dan pemeriksaan pemakaian role lama.
  SUPERVISOR
  ADMIN
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum VehicleStatus {
  AVAILABLE
  MAINTENANCE
  INACTIVE
}

enum DriverStatus {
  ACTIVE
  INACTIVE
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum BusinessTravelStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum BusinessTravelFacilityType {
  FLIGHT_TICKET
  HOTEL
  OTHER_TRANSPORTATION
}

enum ClaimCategory {
  CAR_WASH
  MEALS
  TOLL_FEE
  FUEL
  OTHERS
}

enum ClaimStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
}

enum ClaimRequestStatus {
  PENDING_GA
  PENDING_BRANCH_HEAD
  PENDING_TREASURER
  PROCESSING_PAYMENT
  PAID
  REJECTED
}

enum ClaimReviewStage {
  GA
  BRANCH_HEAD
  TREASURER
}

enum ClaimReviewDecision {
  APPROVED
  REJECTED
}

model User {
  id       String        @id @default(uuid()) @db.Uuid
  email    String        @unique
  password String
  role     UserRole      @default(EMPLOYEE)
  status   AccountStatus @default(ACTIVE)

  employee Employee?

  // Reservasi yang disetujui oleh user (GA)
  approvedReservations    VehicleReservation[]    @relation("ReservationApprover")
  approvedBusinessTravels BusinessTravelRequest[] @relation("BusinessTravelApprover")
  approvedClaims          Claim[]                 @relation("ClaimApprover")
  approvedClaimRequests   ClaimRequest[]          @relation("ClaimRequestApprover")
  claimRequestReviews     ClaimRequestReview[]    @relation("ClaimRequestReviewer")
  paidClaimRequests       ClaimRequest[]          @relation("ClaimRequestPayer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Employee {
  id     String  @id @default(uuid()) @db.Uuid
  userId String? @unique @db.Uuid

  employeeCode String    @unique
  fullName     String
  phone        String?
  department   String?
  position     String?
  workLocation String?
  joinDate     DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  reservations           VehicleReservation[]
  businessTravelRequests BusinessTravelRequest[]
  claims                 Claim[]
  claimRequests          ClaimRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employees")
}

model Vehicle {
  id           String        @id @default(uuid()) @db.Uuid
  vehicleCode  String        @unique
  name         String
  plateNumber  String        @unique
  vehicleType  String?
  seatCapacity Int
  status       VehicleStatus @default(AVAILABLE)

  reservations VehicleReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicles")
}

model Driver {
  id            String       @id @default(uuid()) @db.Uuid
  fullName      String
  phone         String?
  licenseNumber String?      @unique
  status        DriverStatus @default(ACTIVE)

  reservations VehicleReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("drivers")
}

model VehicleReservation {
  id String @id @default(uuid()) @db.Uuid

  employeeId   String  @db.Uuid
  vehicleId    String  @db.Uuid
  driverId     String? @db.Uuid
  approvedById String? @db.Uuid

  startAt DateTime
  endAt   DateTime

  destination    String
  purpose        String
  passengerCount Int

  status     ReservationStatus @default(PENDING)
  reviewNote String?
  reviewedAt DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver   Driver?  @relation(fields: [driverId], references: [id], onDelete: Restrict)

  approvedBy User? @relation("ReservationApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([vehicleId, startAt, endAt])
  @@index([driverId, startAt, endAt])
  @@index([status])
  @@map("vehicle_reservations")
}

model BusinessTravelRequest {
  id           String  @id @default(uuid()) @db.Uuid
  employeeId   String  @db.Uuid
  approvedById String? @db.Uuid

  destination   String
  purpose       String
  departureDate DateTime
  returnDate    DateTime

  transportation String?
  notes          String?

  status     BusinessTravelStatus @default(PENDING)
  reviewNote String?
  reviewedAt DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  approvedBy User? @relation("BusinessTravelApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  facilities BusinessTravelFacility[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([approvedById])
  @@index([status])
  @@index([departureDate, returnDate])
  @@map("business_travel_requests")
}

model BusinessTravelFacility {
  id        String @id @default(uuid()) @db.Uuid
  requestId String @db.Uuid

  type  BusinessTravelFacilityType
  notes String?

  request BusinessTravelRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requestId, type])
  @@index([type])
  @@map("business_travel_facilities")
}

model Claim {
  id              String        @id @default(uuid()) @db.Uuid
  employeeId      String        @db.Uuid
  category        ClaimCategory
  transactionDate DateTime      @db.Date
  reference       String?
  description     String
  amount          Decimal       @db.Decimal(15, 2)

  fuelType        String?
  liters          Decimal? @db.Decimal(10, 2)
  pricePerLiter   Decimal? @db.Decimal(15, 2)
  stationLocation String?

  receiptUrl String?
  notes      String?

  status       ClaimStatus @default(PENDING)
  reviewNote   String?
  approvedById String?     @db.Uuid
  reviewedAt   DateTime?

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  approvedBy User?    @relation("ClaimApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  requestId String?       @db.Uuid
  request   ClaimRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([employeeId])
  @@index([approvedById])
  @@index([status])
  @@index([category])
  @@index([transactionDate])
  @@map("claims")
}

model ClaimRequest {
  id            String  @id @default(uuid()) @db.Uuid
  employeeId    String  @db.Uuid
  requestNumber String  @unique
  totalAmount   Decimal @db.Decimal(15, 2)

  status ClaimRequestStatus @default(PENDING_GA)

  notes        String?
  reviewNote   String?
  approvedById String?   @db.Uuid
  reviewedAt   DateTime?

  paidById         String?   @db.Uuid
  paidAt           DateTime?
  paymentReference String?

  paidBy User? @relation("ClaimRequestPayer", fields: [paidById], references: [id], onDelete: SetNull)

  reviews ClaimRequestReview[]

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  approvedBy User? @relation("ClaimRequestApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  claims Claim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([approvedById])
  @@index([status])
  @@index([createdAt])
  @@map("claim_requests")
}

model ClaimRequestReview {
  id         String              @id @default(uuid()) @db.Uuid
  requestId  String              @db.Uuid
  reviewerId String              @db.Uuid
  stage      ClaimReviewStage
  decision   ClaimReviewDecision
  note       String?
  createdAt  DateTime            @default(now())

  request ClaimRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  reviewer User @relation("ClaimRequestReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@unique([requestId, stage])
  @@index([reviewerId])
  @@index([createdAt])
  @@map("claim_request_reviews")
}
