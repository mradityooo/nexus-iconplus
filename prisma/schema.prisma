
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  EMPLOYEE
  GA
  SUPERVISOR
  ADMIN
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum VehicleStatus {
  AVAILABLE
  MAINTENANCE
  INACTIVE
}

enum DriverStatus {
  ACTIVE
  INACTIVE
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum InspectionStatus {
  DRAFT
  SUBMITTED
  REVIEWED
}

enum InspectionCondition {
  GOOD
  NEEDS_ATTENTION
  NOT_APPLICABLE
}

enum BusinessTravelStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum BusinessTravelFacilityType {
  FLIGHT_TICKET
  HOTEL
  OTHER_TRANSPORTATION
}

// ==========================================
// USER
// ==========================================

model User {
  id       String        @id @default(uuid()) @db.Uuid
  email    String        @unique
  password String
  role     UserRole      @default(EMPLOYEE)
  status   AccountStatus @default(ACTIVE)

  employee Employee?

  // User yang menyetujui reservasi kendaraan
  approvedReservations VehicleReservation[] @relation("ReservationApprover")

  // User yang menyetujui perjalanan dinas
  approvedBusinessTravels BusinessTravelRequest[] @relation("BusinessTravelApprover")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ==========================================
// EMPLOYEE
// ==========================================

model Employee {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String?   @unique @db.Uuid
  employeeCode String    @unique
  fullName     String
  phone        String?
  department   String?
  position     String?
  workLocation String?
  joinDate     DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  inspections           Inspection[]
  reservations          VehicleReservation[]
  businessTravelRequests BusinessTravelRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employees")
}

// ==========================================
// VEHICLE
// ==========================================

model Vehicle {
  id           String        @id @default(uuid()) @db.Uuid
  vehicleCode  String        @unique
  name         String
  plateNumber  String        @unique
  vehicleType  String?
  seatCapacity Int
  status       VehicleStatus @default(AVAILABLE)

  inspections  Inspection[]
  reservations VehicleReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicles")
}

// ==========================================
// DRIVER
// ==========================================

model Driver {
  id            String       @id @default(uuid()) @db.Uuid
  fullName      String
  phone         String?
  licenseNumber String?      @unique
  status        DriverStatus @default(ACTIVE)

  reservations VehicleReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("drivers")
}

// ==========================================
// VEHICLE RESERVATION
// ==========================================

model VehicleReservation {
  id           String  @id @default(uuid()) @db.Uuid
  employeeId   String  @db.Uuid
  vehicleId    String  @db.Uuid
  driverId     String? @db.Uuid
  approvedById String? @db.Uuid

  startAt     DateTime
  endAt       DateTime
  destination String
  purpose     String

  status      ReservationStatus @default(PENDING)
  reviewNote  String?
  reviewedAt  DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver   Driver?  @relation(fields: [driverId], references: [id], onDelete: Restrict)

  approvedBy User? @relation("ReservationApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  inspection Inspection?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([vehicleId, startAt, endAt])
  @@index([driverId, startAt, endAt])
  @@index([status])
  @@map("vehicle_reservations")
}

// ==========================================
// INSPECTION TEMPLATE
// ==========================================

model InspectionTemplate {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  items InspectionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("inspection_templates")
}

// ==========================================
// INSPECTION
// ==========================================

model Inspection {
  id            String @id @default(uuid()) @db.Uuid
  reservationId String @unique @db.Uuid
  employeeId    String @db.Uuid
  vehicleId     String @db.Uuid

  photoPath   String?
  status      InspectionStatus @default(DRAFT)
  notes       String?
  inspectedAt DateTime?

  reservation VehicleReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  employee    Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  vehicle     Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  items InspectionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([vehicleId])
  @@index([status])
  @@map("inspections")
}

// ==========================================
// INSPECTION ITEM
// ==========================================

model InspectionItem {
  id           String @id @default(uuid()) @db.Uuid
  inspectionId String @db.Uuid
  templateId   String @db.Uuid

  condition InspectionCondition?
  notes     String?

  inspection Inspection         @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  template   InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([inspectionId, templateId])
  @@index([templateId])
  @@map("inspection_items")
}

// ==========================================
// BUSINESS TRAVEL REQUEST
// ==========================================

model BusinessTravelRequest {
  id           String @id @default(uuid()) @db.Uuid
  employeeId   String @db.Uuid
  approvedById String? @db.Uuid

  destination   String
  purpose       String
  departureDate DateTime
  returnDate    DateTime

  transportation String?
  notes          String?

  status     BusinessTravelStatus @default(PENDING)
  reviewNote String?
  reviewedAt DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  approvedBy User? @relation("BusinessTravelApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  facilities BusinessTravelFacility[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([approvedById])
  @@index([status])
  @@index([departureDate, returnDate])
  @@map("business_travel_requests")
}

// ==========================================
// BUSINESS TRAVEL FACILITY
// ==========================================

model BusinessTravelFacility {
  id        String @id @default(uuid()) @db.Uuid
  requestId String @db.Uuid

  type  BusinessTravelFacilityType
  notes String?

  request BusinessTravelRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requestId, type])
  @@index([type])
  @@map("business_travel_facilities")
}
